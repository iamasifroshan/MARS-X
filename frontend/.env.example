# MARS-X Frontend Environment Configuration
# Supported variables: NEXT_PUBLIC_API_URL or NEXT_PUBLIC_API_BASE_URL

# For Local Development (leave empty or set to local FastAPI):
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# For Production (Vercel / Cloud):
NEXT_PUBLIC_API_URL=https://mars-x-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=https://mars-x-backend.onrender.com
